executable            = CONDORDIR/submit.sh
arguments             = $(JOBNUM) BASEDIR X509PATH
output                = LOGDIR/JOBNAME.$(ClusterId).$(ProcId).out
error                 = LOGDIR/JOBNAME.$(ClusterId).$(ProcId).err
# one user log per cluster: required by the EosSubmit schedds (module load lxbatch/eossubmit)
log                   = LOGDIR/JOBNAME.$(ClusterId).log

should_transfer_files = YES
transfer_input_files  = INPUTFILES

request_memory        = MEMORY
# one CPU per futures-executor worker (submit.py --workers)
request_cpus          = NCPUS
# rerun a job that exits non-zero (e.g. a transient xrootd failure; coffea 0.7 cannot
# retry single chunks). The output .coffea is written at the end only: reruns are safe
max_retries           = MAXRETRIES

+JobFlavour           = JOBFLAVOR
+SingularityImage     = IMAGE

Queue JOBNUM from JOBNUM_FILE